# Copy to .env and adjust as needed. Never commit the real .env.

APP_NAME=rtb-platform
ENV=local
API_V1_PREFIX=/api/v1

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

DATABASE_URL=postgresql+asyncpg://rtb:rtb@postgres:5432/rtb

REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL_SECONDS=30

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_ENABLED=true

AUCTION_GLOBAL_TIMEOUT_MS=100
AUCTION_DEFAULT_TYPE=SECOND_PRICE
DSP_DEFAULT_TIMEOUT_MS=80

RATE_LIMIT_PUBLISHER_PER_MIN=1000
RATE_LIMIT_ADMIN_PER_MIN=100
RATE_LIMIT_DSP_PER_MIN=500

EVENT_MAX_RETRIES=4
EVENT_RETRY_BASE_SECONDS=1.0
